<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="ParaBank Test Suite" verbose="2" parallel="tests" thread-count="2">

    <listeners>
        <listener class-name="com.parabank.automation.listeners.RetryListener"/>
    </listeners>

    <test name="UI Tests">
        <classes>
            <class name="com.parabank.automation.runners.UiTestRunner"/>
        </classes>
    </test>

    <test name="API Tests">
        <classes>
            <class name="com.parabank.automation.runners.ApiTestRunner"/>
        </classes>
    </test>

</suite>